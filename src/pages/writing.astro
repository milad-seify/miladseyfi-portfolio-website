---
import Writing from '@/components/sections/Writing.astro';
import { getLinkedInPosts, hasLinkedInPreview } from '@/data/linkedin-posts';
import { getDictionary } from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';
import BaseLayout from '@/layouts/BaseLayout.astro';

const locale = 'fa';
const copy = getDictionary(locale).writing;
const localizedResume = getLocalizedResume(locale);
const posts = getLinkedInPosts().filter(hasLinkedInPreview);
---

<BaseLayout
  {locale}
  routePath="writing/"
  title={`${copy.pageTitle} — ${localizedResume.identity.name}`}
  description={copy.pageDescription}
>
  <Writing {posts} {locale} mode="all" />
</BaseLayout>
