---
import { getCollection } from 'astro:content';
import ProjectCaseStudy from '@/components/sections/ProjectCaseStudy.astro';
import { isPublished } from '@/lib/content';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter(isPublished);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
---

<ProjectCaseStudy locale="fa" {project} />
