---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { getDictionary, getLocalePath } from '@/i18n/config';

const copy = getDictionary('fa').notFound;
---

<BaseLayout
  locale="fa"
  routePath="404.html"
  title={copy.title}
  description={copy.description}
  robots="noindex, nofollow"
  hasLocalizedRoute={false}
>
  <section class="not-found shell">
    <p class="eyebrow">ERROR / 404</p>
    <h1>{copy.heading}</h1>
    <p>{copy.body}</p>
    <ButtonLink href={getLocalePath('fa')}>{copy.action}</ButtonLink>
  </section>
</BaseLayout>
