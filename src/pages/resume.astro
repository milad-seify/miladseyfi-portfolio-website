---
import ResumeLayout from '@/layouts/ResumeLayout.astro';
import { resume } from '@/data/resume';
import { formatResumeDateRange } from '@/lib/resume';
import { withBasePath } from '@/lib/urls';

const pdfPath = withBasePath('resume/milad-seyfi-resume.pdf');
const homePath = withBasePath();
const contactLinks = [
  resume.contact.email && { label: resume.contact.email, href: `mailto:${resume.contact.email}` },
  resume.contact.phone && { label: resume.contact.phone, href: `tel:${resume.contact.phone}` },
  resume.contact.website && { label: resume.contact.website, href: resume.contact.website },
  resume.contact.linkedin && { label: 'LinkedIn', href: resume.contact.linkedin },
  resume.contact.github && { label: 'GitHub', href: resume.contact.github },
].filter((item): item is { label: string; href: string } => Boolean(item));
---

<ResumeLayout>
  <nav class="resume-toolbar" aria-label="Resume actions">
    <a href={homePath}>← Portfolio</a>
    <a href={pdfPath} download="milad-seyfi-resume.pdf">
      Download PDF
    </a>
  </nav>

  <main class="resume-sheet" id="resume-content">
    <header class="resume-header">
      <div>
        <p class="resume-kicker">Resume</p>
        <h1>{resume.identity.name}</h1>
        <p class="resume-headline">{resume.identity.professionalHeadline}</p>
      </div>
      {contactLinks.length > 0 && (
        <address class="resume-contact">
          {contactLinks.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </address>
      )}
    </header>

    <section class="resume-summary" aria-labelledby="summary-heading">
      <h2 id="summary-heading">Profile</h2>
      <p>{resume.identity.summary}</p>
      <dl class="resume-metrics" aria-label="Career highlights">
        {resume.careerHighlights.map((highlight) => (
          <div>
            <dt>{highlight.value}</dt>
            <dd>{highlight.label}</dd>
            <dd class="resume-metric__detail">{highlight.detail}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="resume-section" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      {resume.experience.map((experience) => (
        <article class="resume-entry">
          <header class="resume-entry__header">
            <div>
              <h3>{experience.role}</h3>
              <p>{experience.organization}</p>
            </div>
            <div class="resume-entry__meta">
              <time>{formatResumeDateRange(experience.startDate, experience.endDate)}</time>
              {experience.locations && <span>{experience.locations.join(' · ')}</span>}
            </div>
          </header>
          <p>{experience.summary}</p>
          <ul class="resume-list">
            {experience.responsibilities.map((responsibility) => (
              <li>{responsibility}</li>
            ))}
          </ul>
          <div class="resume-callout">
            <strong>Selected results</strong>
            <ul>
              {experience.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </section>

    <section class="resume-section" aria-labelledby="projects-heading">
      <h2 id="projects-heading">Selected projects</h2>
      <div class="resume-projects">
        {resume.selectedProjects.map((project) => (
          <article class="resume-project">
            <h3>
              <a href={withBasePath(`projects/${project.id}/`)}>{project.title}</a>
            </h3>
            <p>{project.summary}</p>
            <ul>
              {project.contributions.map((contribution) => (
                <li>{contribution}</li>
              ))}
            </ul>
            {project.verifiedResult && <strong>{project.verifiedResult}</strong>}
            <p class="resume-project__tech">{project.technologies.join(' · ')}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Technical expertise</h2>
      <div class="resume-skills">
        {resume.skillGroups.map((group) => (
          <article>
            <h3>{group.title}</h3>
            <p>{group.skills.join(' · ')}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="resume-section resume-education" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      {resume.education.map((education) => (
        <article class="resume-entry__header">
          <div>
            <h3>
              {education.degree} in {education.field}
            </h3>
            <p>{education.institution}</p>
          </div>
          {education.status && <p class="resume-entry__meta">{education.status}</p>}
        </article>
      ))}
    </section>

    {resume.certifications.length > 0 && (
      <section class="resume-section" aria-labelledby="certifications-heading">
        <h2 id="certifications-heading">Certifications</h2>
        <ul class="resume-certifications">
          {resume.certifications.map((certification) => (
            <li>
              <strong>{certification.name}</strong> — {certification.issuer}
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</ResumeLayout>
