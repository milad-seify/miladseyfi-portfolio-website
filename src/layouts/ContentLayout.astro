---
import BaseLayout from './BaseLayout.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { getDictionary, getLocalePath, type Locale } from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';

interface Props {
  locale: Locale;
  routePath: string;
  title: string;
  description: string;
  eyebrow: string;
}
const { locale, routePath, title, description, eyebrow } = Astro.props;
const copy = getDictionary(locale).caseStudy;
const personName = getLocalizedResume(locale).identity.name;
---

<BaseLayout {locale} {routePath} title={`${title} — ${personName}`} {description} type="article">
  <article class="content-page shell">
    <ButtonLink href={getLocalePath(locale)} variant="quiet">
      {copy.back}
    </ButtonLink>
    <header>
      <p class="eyebrow">
        <span aria-hidden="true">//</span> {eyebrow}
      </p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
