---
import { profile } from '@/data/profile';
import { resume } from '@/data/resume';
import { getDictionary, getDirection, getLocalePath, type Locale } from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';
import { withBasePath } from '@/lib/urls';
import '@/styles/resume.css';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const localizedResume = getLocalizedResume(locale);
const title = `${localizedResume.identity.name} — ${dictionary.resume.title}`;
const siteOrigin = Astro.site ?? Astro.url.origin;
const routePath = 'resume/';
const canonical = new URL(getLocalePath(locale, routePath), siteOrigin);
const persianAlternate = new URL(getLocalePath('fa', routePath), siteOrigin);
const englishAlternate = new URL(getLocalePath('en', routePath), siteOrigin);
const siteHome = new URL(getLocalePath(locale), siteOrigin);
const socialImage = new URL(withBasePath(profile.site.socialImage), siteOrigin);
const sameAs = [
  resume.contact.linkedin,
  resume.contact.github,
  resume.contact.telegram,
  resume.contact.whatsapp,
  resume.contact.website,
].filter((url): url is string => Boolean(url));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.href,
  inLanguage: locale,
  mainEntity: {
    '@type': 'Person',
    name: resume.identity.name,
    jobTitle: localizedResume.identity.professionalHeadline,
    description: localizedResume.identity.summary,
    url: siteHome.href,
    ...(resume.contact.email ? { email: resume.contact.email } : {}),
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
};
---

<!doctype html>
<html lang={locale} dir={getDirection(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={localizedResume.identity.summary} />
    <meta name="theme-color" content="#f5f7fa" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fa" href={persianAlternate} />
    <link rel="alternate" hreflang="en" href={englishAlternate} />
    <link rel="alternate" hreflang="x-default" href={persianAlternate} />
    {resume.contact.linkedin && <link rel="me" href={resume.contact.linkedin} />}
    <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')} />
    <link rel="manifest" href={withBasePath('site.webmanifest')} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={localizedResume.identity.summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'fa' ? 'en_US' : 'fa_IR'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${localizedResume.identity.name} — ${localizedResume.identity.professionalHeadline}`}
    />
    <meta property="og:site_name" content={localizedResume.identity.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={localizedResume.identity.summary} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content={`${localizedResume.identity.name} — ${localizedResume.identity.professionalHeadline}`}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="resume-skip-link" href="#resume-content">
      {dictionary.resume.skip}
    </a>
    <slot />
  </body>
</html>
