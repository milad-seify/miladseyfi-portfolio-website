---
import Wordmark from '@/components/ui/Wordmark.astro';
import { profile } from '@/data/profile';
import { resume } from '@/data/resume';
import { withBasePath } from '@/lib/urls';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const {
  title = profile.site.title,
  description = profile.site.description,
  image = profile.site.socialImage,
  type = 'website',
  robots,
} = Astro.props;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, siteOrigin);
const siteHome = new URL(withBasePath(), siteOrigin);
const socialImage = new URL(withBasePath(image), siteOrigin);
const sameAs = [resume.contact.linkedin, resume.contact.github, resume.contact.website].filter(
  (url): url is string => Boolean(url),
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.identity.name,
  jobTitle: resume.identity.professionalHeadline,
  description: resume.identity.summary,
  url: siteHome.href,
  knowsAbout: resume.skillGroups.flatMap((group) => group.skills),
  hasOccupation: resume.experience.map((experience) => ({
    '@type': 'Occupation',
    name: experience.role,
    description: experience.summary,
    occupationLocation: experience.locations?.map((location) => ({
      '@type': 'City',
      name: location,
    })),
  })),
  affiliation: resume.education.map((education) => ({
    '@type': 'EducationalOrganization',
    name: education.institution,
  })),
  ...(resume.contact.email ? { email: resume.contact.email } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<!doctype html>
<html lang={profile.site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={profile.site.themeColor} />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {resume.contact.linkedin && <link rel="me" href={resume.contact.linkedin} />}
    <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')} />
    <link rel="manifest" href={withBasePath('site.webmanifest')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${resume.identity.name} — ${resume.identity.professionalHeadline}`}
    />
    <meta property="og:site_name" content={resume.identity.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content={`${resume.identity.name} — ${resume.identity.professionalHeadline}`}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <Wordmark />
        <nav class="desktop-nav" aria-label="Primary navigation">
          <ul>
            {profile.navigation.map((item) => (
              <li>
                <a href={withBasePath(item.href)}>{item.label}</a>
              </li>
            ))}
          </ul>
          <a class="nav-cta" href={withBasePath('#contact')}>
            Let’s talk <span aria-hidden="true">↗</span>
          </a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Toggle navigation">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <nav aria-label="Mobile navigation">
            {profile.navigation.map((item) => (
              <a href={withBasePath(item.href)}>{item.label}</a>
            ))}
            <a href={withBasePath('#contact')}>Let’s talk</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <Wordmark />
        <p>Architecture for systems—and teams—that need to last.</p>
        <p>
          © {new Date().getUTCFullYear()} {resume.identity.name}
        </p>
      </div>
    </footer>
  </body>
</html>
