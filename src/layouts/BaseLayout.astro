---
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import Wordmark from '@/components/ui/Wordmark.astro';
import { profile } from '@/data/profile';
import { resume } from '@/data/resume';
import {
  defaultLocale,
  getDictionary,
  getDirection,
  getLocalePath,
  type Locale,
} from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';
import { withBasePath } from '@/lib/urls';
import '@/styles/global.css';

interface Props {
  locale?: Locale;
  routePath?: string;
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
  hasLocalizedRoute?: boolean;
}

const {
  locale = defaultLocale,
  routePath = '',
  title,
  description,
  image = profile.site.socialImage,
  type = 'website',
  robots,
  hasLocalizedRoute = true,
} = Astro.props;
const dictionary = getDictionary(locale);
const localizedResume = getLocalizedResume(locale);
const pageTitle = title ?? dictionary.meta.title;
const pageDescription = description ?? dictionary.meta.description;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonical = new URL(getLocalePath(locale, routePath), siteOrigin);
const persianAlternate = new URL(getLocalePath('fa', routePath), siteOrigin);
const englishAlternate = new URL(getLocalePath('en', routePath), siteOrigin);
const siteHome = new URL(getLocalePath(locale), siteOrigin);
const socialImage = new URL(withBasePath(image), siteOrigin);
const sameAs = [
  resume.contact.linkedin,
  resume.contact.github,
  resume.contact.telegram,
  resume.contact.whatsapp,
  resume.contact.website,
].filter((url): url is string => Boolean(url));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: resume.identity.name,
  jobTitle: localizedResume.identity.professionalHeadline,
  description: localizedResume.identity.summary,
  url: siteHome.href,
  knowsAbout: resume.skillGroups.flatMap((group) => group.skills),
  hasOccupation: resume.experience.map((experience) => ({
    '@type': 'Occupation',
    name: experience.role,
    description: experience.summary,
    occupationLocation: experience.locations?.map((location) => ({
      '@type': 'City',
      name: location,
    })),
  })),
  ...(resume.contact.email ? { email: resume.contact.email } : {}),
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
---

<!doctype html>
<html lang={locale} dir={getDirection(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={profile.site.themeColor} />
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonical} />
    {hasLocalizedRoute && <link rel="alternate" hreflang="fa" href={persianAlternate} />}
    {hasLocalizedRoute && <link rel="alternate" hreflang="en" href={englishAlternate} />}
    {hasLocalizedRoute && <link rel="alternate" hreflang="x-default" href={persianAlternate} />}
    {resume.contact.linkedin && <link rel="me" href={resume.contact.linkedin} />}
    <link rel="icon" type="image/svg+xml" href={withBasePath('favicon.svg')} />
    <link rel="manifest" href={withBasePath('site.webmanifest')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'fa' ? 'en_US' : 'fa_IR'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${localizedResume.identity.name} — ${localizedResume.identity.professionalHeadline}`}
    />
    <meta property="og:site_name" content={localizedResume.identity.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta
      name="twitter:image:alt"
      content={`${localizedResume.identity.name} — ${localizedResume.identity.professionalHeadline}`}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {locale === 'fa' ? 'رفتن به محتوا' : 'Skip to content'}
    </a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <Wordmark {locale} />
        <nav
          class="desktop-nav"
          aria-label={locale === 'fa' ? 'ناوبری اصلی' : 'Primary navigation'}
        >
          <ul>
            {dictionary.navigation.map((item) => (
              <li>
                <a href={`${getLocalePath(locale)}${item.href}`}>{item.label}</a>
              </li>
            ))}
          </ul>
          <LanguageSwitcher {locale} routePath={hasLocalizedRoute ? routePath : ''} />
          <a class="nav-cta" href={`${getLocalePath(locale)}#contact`}>
            {dictionary.header.contact} <span aria-hidden="true">↗</span>
          </a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label={dictionary.header.menu}>
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <nav aria-label={locale === 'fa' ? 'ناوبری موبایل' : 'Mobile navigation'}>
            {dictionary.navigation.map((item) => (
              <a href={`${getLocalePath(locale)}${item.href}`}>{item.label}</a>
            ))}
            <LanguageSwitcher {locale} routePath={hasLocalizedRoute ? routePath : ''} />
            <a href={`${getLocalePath(locale)}#contact`}>{dictionary.header.contact}</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <Wordmark {locale} />
        <p>{dictionary.footer.statement}</p>
        <p>
          © {new Date().getUTCFullYear()} {resume.identity.name}
        </p>
      </div>
    </footer>
  </body>
</html>
