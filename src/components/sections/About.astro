---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getDictionary(locale).about;
---

<section class="section shell" id="about" aria-labelledby="about-heading">
  <div class="about reveal">
    <p class="section-coordinate" aria-hidden="true">
      01 / POSITION
    </p>
    <SectionHeading id="about-heading" eyebrow={copy.eyebrow} heading={copy.heading} />
    <div class="about__body">
      {copy.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <ol class="principles">
      {copy.principles.map((principle) => (
        <li>
          <span>{principle.value}</span>
          {principle.label}
        </li>
      ))}
    </ol>
  </div>
</section>
