---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Icon from '@/components/ui/Icon.astro';
import TechnicalTerm from '@/components/ui/TechnicalTerm.astro';
import { getDictionary, type Locale } from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getDictionary(locale).hero;
const localizedResume = getLocalizedResume(locale);
---

<section class="hero shell" aria-labelledby="hero-title">
  <div class="hero__copy">
    <p class="hero__status">
      <span></span>
      {copy.status}
    </p>
    <h1 id="hero-title">{copy.title}</h1>
    <p class="hero__summary">{copy.summary}</p>
    <div class="hero__actions">
      <ButtonLink href="#work">{copy.workCta}</ButtonLink>
      <ButtonLink href="#contact" variant="secondary">
        {copy.contactCta}
      </ButtonLink>
    </div>
    <dl class="hero__signals" aria-label={copy.metricsLabel}>
      {localizedResume.careerHighlights.map((highlight) => (
        <div>
          <dt>{highlight.label}</dt>
          <dd>{highlight.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class="hero__visual" aria-hidden="true">
    <div class="orb orb--one"></div>
    <div class="orb orb--two"></div>
    <div class="architecture-map">
      <div class="architecture-map__topline">
        <span>{copy.topology}</span>
        <span class="live-dot">{copy.stable}</span>
      </div>
      <div class="node node--cloud">
        <Icon name="cloud" size={24} />
        <span>
          <TechnicalTerm>{copy.cloud}</TechnicalTerm>
        </span>
      </div>
      <div class="connector connector--one"></div>
      <div class="node node--platform">
        <Icon name="layers" size={24} />
        <span>
          <TechnicalTerm>{copy.platform}</TechnicalTerm>
        </span>
      </div>
      <div class="connector connector--two"></div>
      <div class="node node--automation">
        <Icon name="terminal" size={24} />
        <span>
          <TechnicalTerm>{copy.automation}</TechnicalTerm>
        </span>
      </div>
      <div class="node node--storage">
        <Icon name="storage" size={24} />
        <span>
          <TechnicalTerm>{copy.storage}</TechnicalTerm>
        </span>
      </div>
      <div class="map-metrics">
        <span>
          <i></i>
          {copy.observable}
        </span>
        <span>
          <i></i>
          {copy.repeatable}
        </span>
        <span>
          <i></i>
          {copy.operable}
        </span>
      </div>
    </div>
  </div>
</section>
