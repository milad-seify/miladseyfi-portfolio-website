---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TechnicalTerm from '@/components/ui/TechnicalTerm.astro';
import { getDictionary, type Locale } from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';
import { formatResumeDateRange } from '@/lib/resume';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getDictionary(locale).experience;
const localizedResume = getLocalizedResume(locale);
---

<section
  class="section section--bordered shell"
  id="experience"
  aria-labelledby="experience-heading"
>
  <div class="experience reveal">
    <p class="section-coordinate" aria-hidden="true">
      03 / CHRONOLOGY
    </p>
    <SectionHeading
      id="experience-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.note}
    />
    <div class="timeline">
      {localizedResume.experience.map((item, index) => (
        <article class="timeline__item" data-entry={String(index + 1).padStart(2, '0')}>
          <div class="timeline__rail">
            <span></span>
          </div>
          <p class="timeline__period">
            {formatResumeDateRange(item.startDate, item.endDate, locale)}
          </p>
          <div>
            <h3>{item.role}</h3>
            <p class="timeline__org">{item.organization}</p>
            <p>{item.summary}</p>
            <ul class="experience__highlights">
              {item.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <ul class="tag-list" aria-label={copy.practiceAreas}>
              {item.skills.map((tag) => (
                <li>
                  <TechnicalTerm>{tag}</TechnicalTerm>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
      {localizedResume.education.map((education, index) => (
        <aside class="education-card" aria-labelledby={`education-heading-${index}`}>
          <p class="timeline__period">{copy.education}</p>
          <h3 id={`education-heading-${index}`}>
            {education.degree} in {education.field}
          </h3>
          <p>
            {education.institution}
            {education.status ? ` · ${education.status}` : ''}
          </p>
        </aside>
      ))}
    </div>
  </div>
</section>
