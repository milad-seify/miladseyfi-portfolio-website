---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TechnicalTerm from '@/components/ui/TechnicalTerm.astro';
import { getDictionary, getLocalePath, type Locale } from '@/i18n/config';
import { getProjectPresentation } from '@/i18n/projects';

interface Props {
  projects: CollectionEntry<'projects'>[];
  locale: Locale;
}
const { projects, locale } = Astro.props;
const copy = getDictionary(locale).projects;
---

<section class="section section--tinted" id="work" aria-labelledby="work-heading">
  <div class="shell reveal">
    <SectionHeading
      id="work-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.description}
    />
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project, index) => {
          const presentation = getProjectPresentation(locale, project);
          return (
            <article
              class:list={[
                'project-card',
                index === 0 ? 'project-card--feature' : 'project-card--compact',
              ]}
            >
              <span class="project-card__index" aria-hidden="true">
                / {String(index + 1).padStart(2, '0')}
              </span>
              <div class="project-card__meta">
                <span>{presentation.context}</span>
                <span>{presentation.role}</span>
              </div>
              <strong class="project-card__highlight">{presentation.highlight}</strong>
              <h3>
                <a href={getLocalePath(locale, `projects/${project.id}/`)}>{presentation.title}</a>
              </h3>
              <p>{presentation.summary}</p>
              <ul class="tag-list">
                {project.data.technologies.map((item) => (
                  <li>
                    <TechnicalTerm>{item}</TechnicalTerm>
                  </li>
                ))}
              </ul>
              <a class="text-link" href={getLocalePath(locale, `projects/${project.id}/`)}>
                {copy.read} <Icon name="arrow" size={16} />
              </a>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-state__code">{copy.emptyCode}</span>
        <h3>{copy.emptyTitle}</h3>
        <p>{copy.emptyDescription}</p>
      </div>
    )}
  </div>
</section>
