---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { profile } from '@/data/profile';
import { withBasePath } from '@/lib/urls';

interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---

<section class="section section--tinted" id="work" aria-labelledby="work-heading">
  <div class="shell reveal">
    <SectionHeading
      id="work-heading"
      eyebrow="Selected work"
      heading={profile.workIntro.heading}
      description={profile.workIntro.description}
    />
    {projects.length > 0 ? (
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-card__meta">
              <span>{project.data.context}</span>
              <span>{project.data.role}</span>
            </div>
            <strong class="project-card__highlight">{project.data.highlight}</strong>
            <h3>
              <a href={withBasePath(`projects/${project.id}/`)}>{project.data.title}</a>
            </h3>
            <p>{project.data.summary}</p>
            <ul class="tag-list">
              {project.data.technologies.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a class="text-link" href={withBasePath(`projects/${project.id}/`)}>
              Read case study <Icon name="arrow" size={16} />
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <span class="empty-state__code">CASE_STUDIES / IN_REVIEW</span>
        <h3>Detailed case studies are being prepared.</h3>
        <p>Client context, dates, decisions, and outcomes will be added only after verification.</p>
      </div>
    )}
  </div>
</section>
