---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { formatDate, getDictionary, getLocalePath, type Locale } from '@/i18n/config';

interface Props {
  posts: CollectionEntry<'posts'>[];
  locale: Locale;
}
const { posts, locale } = Astro.props;
const copy = getDictionary(locale).writing;
---

<section class="section writing-section" id="writing" aria-labelledby="writing-heading">
  <div class="shell reveal">
    <SectionHeading
      id="writing-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.description}
    />
    {posts.length > 0 ? (
      <div class="writing-list">
        {posts.map((post) => (
          <article>
            <p>
              {post.data.publishedAt ? `${formatDate(post.data.publishedAt, locale)} · ` : ''}
              {post.data.tags.join(' / ')}
            </p>
            <h3>
              <a href={getLocalePath(locale, `posts/${post.id}/`)}>{post.data.title}</a>
            </h3>
            <span>{post.data.description}</span>
            <Icon name="arrow" size={20} />
          </article>
        ))}
      </div>
    ) : (
      <div class="writing-empty">
        <p class="eyebrow">{copy.queue}</p>
        <p>{copy.empty}</p>
      </div>
    )}
  </div>
</section>
