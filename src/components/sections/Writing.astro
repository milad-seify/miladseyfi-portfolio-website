---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { LinkedInPost } from '@/data/linkedin-posts';
import { resume } from '@/data/resume';
import { formatDate, getDictionary, type Locale } from '@/i18n/config';

interface Props {
  posts: LinkedInPost[];
  locale: Locale;
}
const { posts, locale } = Astro.props;
const copy = getDictionary(locale).writing;
---

<section class="section writing-section" id="writing" aria-labelledby="writing-heading">
  <div class="shell reveal">
    <SectionHeading
      id="writing-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.description}
    />
    {posts.length > 0 ? (
      <div class="writing-list">
        {posts.map((post) => (
          <article>
            <p>
              {formatDate(new Date(`${post.publishedAt}T00:00:00Z`), locale)}
              {post.category ? ` · ${post.category}` : ''}
            </p>
            <h3>
              <a href={post.url} target="_blank" rel="noreferrer">
                {post.title}
              </a>
            </h3>
            <span>{post.summary}</span>
            <small>{copy.source}</small>
            <Icon name="external" size={20} />
          </article>
        ))}
      </div>
    ) : (
      <div class="writing-empty">
        <p>{copy.empty}</p>
        {resume.contact.linkedin && (
          <ButtonLink href={resume.contact.linkedin} external variant="secondary">
            {copy.profileCta}
          </ButtonLink>
        )}
      </div>
    )}
  </div>
</section>
