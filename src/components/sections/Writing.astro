---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import LinkedInCard from '@/components/ui/LinkedInCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { LinkedInPost } from '@/data/linkedin-posts';
import { resume } from '@/data/resume';
import { getDictionary, getLocalePath, type Locale } from '@/i18n/config';

interface Props {
  posts: readonly LinkedInPost[];
  locale: Locale;
  mode?: 'preview' | 'all';
}

const { posts, locale, mode = 'preview' } = Astro.props;
const copy = getDictionary(locale).writing;
const hasPosts = posts.length > 0;
const visibleCount = Math.min(posts.length, 3);
---

<section
  class:list={['section writing-section', mode === 'all' && 'writing-section--all']}
  id={mode === 'preview' ? 'writing' : undefined}
  aria-labelledby="writing-heading"
>
  <div class="shell reveal">
    <SectionHeading
      id="writing-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.description}
    />
    {hasPosts ? (
      <>
        <div class="writing-actions">
          {resume.contact.linkedin && (
            <ButtonLink href={resume.contact.linkedin} external variant="secondary">
              {copy.profileCta}
            </ButtonLink>
          )}
          <ButtonLink
            href={mode === 'preview' ? getLocalePath(locale, 'writing/') : getLocalePath(locale)}
            variant="quiet"
          >
            {mode === 'preview' ? copy.viewAll : copy.backHome}
          </ButtonLink>
        </div>
        <ol
          class:list={[
            'writing-grid',
            mode === 'preview' && 'writing-grid--preview',
            `writing-grid--count-${visibleCount}`,
          ]}
        >
          {posts.map((post, index) => (
            <li>
              <LinkedInCard {post} {locale} {index} />
            </li>
          ))}
        </ol>
      </>
    ) : (
      <div class="writing-empty">
        <p>{copy.empty}</p>
        <div class="writing-empty__actions">
          {resume.contact.linkedin && (
            <ButtonLink href={resume.contact.linkedin} external variant="secondary">
              {copy.profileCta}
            </ButtonLink>
          )}
          <ButtonLink href={getLocalePath(locale)} variant="quiet">
            {copy.backHome}
          </ButtonLink>
        </div>
      </div>
    )}
  </div>
</section>
