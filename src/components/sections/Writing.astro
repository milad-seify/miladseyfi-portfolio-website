---
import type { CollectionEntry } from 'astro:content';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { formatDate } from '@/lib/content';

interface Props {
  posts: CollectionEntry<'posts'>[];
}
const { posts } = Astro.props;
---

<section class="section shell" id="writing" aria-labelledby="writing-heading">
  <div class="reveal">
    <SectionHeading
      eyebrow="Notes & articles"
      heading="Thinking in public, carefully."
      description="Field notes on cloud architecture, platform engineering, and the decisions behind reliable systems."
    />
    {posts.length > 0 ? (
      <div class="writing-list">
        {posts.map((post) => (
          <article>
            <p>
              {formatDate(post.data.publishedAt)} · {post.data.tags.join(' / ')}
            </p>
            <h3>
              <a href={`${import.meta.env.BASE_URL}posts/${post.id}/`}>{post.data.title}</a>
            </h3>
            <span>{post.data.description}</span>
            <Icon name="arrow" size={20} />
          </article>
        ))}
      </div>
    ) : (
      <div class="writing-empty">
        <p class="eyebrow">EDITORIAL_QUEUE / 00</p>
        <p>First articles are in review. No placeholder publication claims are shown.</p>
      </div>
    )}
  </div>
</section>
