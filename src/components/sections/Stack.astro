---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { resume } from '@/data/resume';
---

<section class="section section--bordered shell" id="stack" aria-labelledby="stack-heading">
  <div class="stack reveal">
    <SectionHeading
      id="stack-heading"
      eyebrow="Technology stack"
      heading="Tools, platforms, and control planes."
      description="Technologies used across architecture, provisioning, automation, and operations."
    />
    <div class="stack__matrix">
      {resume.skillGroups.map((group) => (
        <div class="stack__row">
          <h3>{group.title}</h3>
          <ul>
            {group.skills.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
