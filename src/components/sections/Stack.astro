---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import TechnicalTerm from '@/components/ui/TechnicalTerm.astro';
import { getDictionary, type Locale } from '@/i18n/config';
import { getLocalizedResume } from '@/i18n/resume';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getDictionary(locale).stack;
const localizedResume = getLocalizedResume(locale);
---

<section class="section section--bordered shell" id="stack" aria-labelledby="stack-heading">
  <div class="stack reveal">
    <p class="section-coordinate" aria-hidden="true">
      06 / ECOSYSTEM
    </p>
    <SectionHeading
      id="stack-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.description}
    />
    <div class="stack__matrix">
      <div class="stack__axis" aria-hidden="true">
        <span>INFRASTRUCTURE</span>
        <i></i>
        <span>OPERATIONS</span>
      </div>
      {localizedResume.skillGroups.map((group, index) => (
        <div class="stack__row" data-layer={String(index + 1).padStart(2, '0')}>
          <h3>{group.title}</h3>
          <ul>
            {group.skills.map((item) => (
              <li>
                <TechnicalTerm>{item}</TechnicalTerm>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
