---
import { getCollection } from 'astro:content';
import About from './About.astro';
import Contact from './Contact.astro';
import Experience from './Experience.astro';
import Expertise from './Expertise.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Services from './Services.astro';
import Stack from './Stack.astro';
import Writing from './Writing.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/config';
import { byNewest, byOrder, isPublished } from '@/lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const projects = (await getCollection('projects')).filter(isPublished).sort(byOrder);
const posts = (await getCollection('posts'))
  .filter(isPublished)
  .filter((post) => post.data.locale === locale)
  .sort(byNewest);
---

<BaseLayout {locale}>
  <Hero {locale} />
  <About {locale} />
  <Experience {locale} />
  <Expertise {locale} />
  <Projects {projects} {locale} />
  <Services {locale} />
  <Stack {locale} />
  <Writing {posts} {locale} />
  <Contact {locale} />
</BaseLayout>
