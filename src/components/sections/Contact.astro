---
import ContactForm from './ContactForm.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { resume } from '@/data/resume';
import { getProfileContent } from '@/data/profile-content';
import { getDictionary, getLocalePath, type Locale } from '@/i18n/config';
import { withBasePath } from '@/lib/urls';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const copy = getDictionary(locale).contact;
const profileContent = getProfileContent(locale).contact;
const resumePage = getLocalePath(locale, 'resume/');
const resumePdf = withBasePath(`resume/resume-${locale}.pdf`);
type ChannelKey = keyof typeof copy.channelLabels;
const channels: { key: ChannelKey; href: string; external: boolean }[] = [];
if (resume.contact.linkedin) channels.push({ key: 'linkedin', href: resume.contact.linkedin, external: true });
if (resume.contact.email) channels.push({ key: 'email', href: `mailto:${resume.contact.email}`, external: false });
---

<section class="contact-section" id="contact" aria-labelledby="contact-heading">
  <div class="shell contact reveal">
    <div class="contact__intro">
      <p class="eyebrow"><span aria-hidden="true">//</span> {copy.eyebrow}</p>
      <h2 id="contact-heading">{profileContent.heading}</h2>
      <p class="contact__summary">{profileContent.summary}</p>
      <ul class="contact__topics" aria-label={copy.topicsLabel}>{profileContent.topics.map((topic) => <li>{topic}</li>)}</ul>
    </div>
    <ContactForm {locale} />
    <div class="contact__secondary">
      <div class="contact__channels">
        {channels.map((channel) => <ButtonLink href={channel.href} external={channel.external} variant="secondary">{copy.channelLabels[channel.key]}</ButtonLink>)}
      </div>
      <div class="contact__resume-actions">
        <ButtonLink href={resumePage} variant="secondary">{copy.resume}</ButtonLink>
        <ButtonLink href={resumePdf} variant="quiet" download={`resume-${locale}.pdf`}>{copy.pdf}</ButtonLink>
      </div>
    </div>
  </div>
</section>
