---
import { getDictionary, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getDictionary(locale).contact.form;
const configuredEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim();
let endpoint: string | undefined;
if (configuredEndpoint) {
  try {
    const url = new URL(configuredEndpoint);
    if (url.protocol === 'https:') endpoint = url.href;
  } catch {
    endpoint = undefined;
  }
}
---

<div class="contact-form-panel">
  <div class="contact-form-panel__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h3>{copy.heading}</h3>
    <p>{copy.description}</p>
  </div>
  {endpoint ? (
    <form class="contact-form" action={endpoint} method="POST">
      <div class="contact-form__grid">
        <label>
          <span>{copy.name}</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>{copy.contact}</span>
          <input name="contact" type="text" autocomplete="email" required />
        </label>
        <label>
          <span>
            {copy.company} <small>({copy.optional})</small>
          </span>
          <input name="company" type="text" autocomplete="organization" />
        </label>
        <label>
          <span>{copy.subject}</span>
          <input name="subject" type="text" required />
        </label>
      </div>
      <label class="contact-form__message">
        <span>{copy.message}</span>
        <textarea name="message" rows="6" required />
      </label>
      <label class="contact-form__honeypot" aria-hidden="true">
        <span>{copy.honeypot}</span>
        <input name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </label>
      <div class="contact-form__footer">
        <p>{copy.privacy}</p>
        <button class="button button--primary" type="submit">
          {copy.submit}
        </button>
      </div>
    </form>
  ) : (
    <div class="contact-form__unavailable" role="status">
      <p>{copy.unavailable}</p>
    </div>
  )}
</div>
