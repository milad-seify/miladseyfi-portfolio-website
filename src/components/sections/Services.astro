---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary, type Locale } from '@/i18n/config';
import { getProfileContent } from '@/data/profile-content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getDictionary(locale).services;
const profileContent = getProfileContent(locale).services;
---

<section class="section services-section" id="services" aria-labelledby="services-heading">
  <div class="shell reveal">
    <SectionHeading
      id="services-heading"
      eyebrow={copy.eyebrow}
      heading={profileContent.heading}
      description={profileContent.description}
    />
    <div class="services-grid">
      {profileContent.items.map((service, index) => (
        <article class="service-card">
          <span class="service-card__number">0{index + 1}</span>
          <div class="service-card__copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <ul>
            {service.deliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
