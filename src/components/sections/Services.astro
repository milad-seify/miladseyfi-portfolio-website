---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getDictionary, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = getDictionary(locale).services;
---

<section class="section shell" id="services" aria-labelledby="services-heading">
  <div class="reveal">
    <p class="section-coordinate" aria-hidden="true">
      05 / CONSULTING INTERFACES
    </p>
    <SectionHeading
      id="services-heading"
      eyebrow={copy.eyebrow}
      heading={copy.heading}
      description={copy.description}
    />
    <div class="services-grid">
      {copy.items.map((service, index) => (
        <article class="service-card">
          <span class="service-card__number">0{index + 1}</span>
          <div class="service-card__copy">
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
          <ul>
            {service.deliverables.map((item) => (
              <li>
                <Icon name="check" size={17} />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
