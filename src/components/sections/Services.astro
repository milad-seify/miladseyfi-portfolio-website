---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { profile } from '@/data/profile';
---

<section class="section shell" id="services" aria-labelledby="services-heading">
  <div class="reveal">
    <SectionHeading
      id="services-heading"
      eyebrow="Consulting"
      heading={profile.servicesIntro.heading}
      description={profile.servicesIntro.description}
    />
    <div class="services-grid">
      {profile.services.map((service, index) => (
        <article class="service-card">
          <span class="service-card__number">0{index + 1}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul>
            {service.deliverables.map((item) => (
              <li>
                <Icon name="check" size={17} />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
