---
import { Image } from 'astro:assets';
import type { ProfilePhoto } from '@/data/media';
import type { Locale } from '@/i18n/config';

interface Props {
  photo: ProfilePhoto | null;
  locale: Locale;
}

const { photo, locale } = Astro.props;
---

{photo ? (
  <figure
    class="profile-portrait profile-portrait--photo"
    style={`--portrait-position: ${photo.position ?? '50% 50%'}`}
  >
    <Image
      src={photo.src}
      alt={photo.alt[locale]}
      widths={[360, 480, 720, 960]}
      sizes="(min-width: 1024px) 32vw, calc(100vw - 2.2rem)"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
    />
    {photo.caption && <figcaption>{photo.caption[locale]}</figcaption>}
  </figure>
) : (
  <div class="profile-portrait profile-portrait--fallback" aria-hidden="true">
    <span>MS</span>
    <i></i>
  </div>
)}
