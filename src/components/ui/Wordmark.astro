---
import { resume } from '@/data/resume';
import { withBasePath } from '@/lib/urls';

const initials = resume.identity.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('');
---

<a class="wordmark" href={withBasePath()} aria-label={`${resume.identity.name}, home`}>
  <span class="wordmark__mark" aria-hidden="true">
    {initials}
  </span>
  <span class="wordmark__text">
    <strong>{resume.identity.name}</strong>
    <small>Cloud · Platform · DevOps</small>
  </span>
</a>
