---
import { resume } from '@/data/resume';
import { getDictionary, getLocalePath, type Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);

const initials = resume.identity.name
  .split(/\s+/)
  .map((part) => part[0])
  .join('');
---

<a
  class="wordmark"
  href={getLocalePath(locale)}
  aria-label={`${resume.identity.name}, ${dictionary.header.home}`}
>
  <span class="wordmark__mark" aria-hidden="true">
    {initials}
  </span>
  <span class="wordmark__text">
    <strong>{resume.identity.name}</strong>
    <small>{dictionary.wordmark}</small>
  </span>
</a>
