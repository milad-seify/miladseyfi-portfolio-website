---
import Icon from './Icon.astro';
import { getLinkedInPostUrl, type LinkedInPost } from '@/data/linkedin-posts';
import { resume } from '@/data/resume';
import { formatDate, getDictionary, type Locale } from '@/i18n/config';

interface Props {
  post: LinkedInPost;
  locale: Locale;
  index: number;
}

const { post, locale, index } = Astro.props;
const copy = getDictionary(locale).writing;
const number = new Intl.NumberFormat(locale === 'fa' ? 'fa-IR' : 'en', {
  minimumIntegerDigits: 2,
}).format(index + 1);
const title = post.title ?? copy.postFallback.replace('{number}', number);
const excerpt = post.excerpt ?? post.summary;
const topic = post.topic ?? post.category;
const dateValue = post.date ?? post.publishedAt;
const date = dateValue ? formatDate(new Date(`${dateValue}T00:00:00Z`), locale) : undefined;
const hasEditorialMetadata = Boolean(topic || date || post.title || excerpt);
const directPostUrl = getLinkedInPostUrl(post);
const href = directPostUrl ?? resume.contact.linkedin;
const editorialLinkLabel = directPostUrl ? copy.postCta : copy.profileFallback;
const compactLinkLabel = directPostUrl ? copy.embedCta : copy.profileFallback;
---

{hasEditorialMetadata ? (
  <article class="linkedin-card linkedin-card--editorial">
    <header class="linkedin-card__meta">
      <span aria-hidden="true">{number}</span>
      <div>
        {topic && <span>{topic}</span>}
        {date && <time datetime={dateValue}>{date}</time>}
        {!topic && !date && <span>LinkedIn</span>}
      </div>
    </header>
    <h3>{title}</h3>
    {excerpt && <p>{excerpt}</p>}
    <a class="text-link" href={href} target="_blank" rel="noreferrer">
      {editorialLinkLabel} <Icon name="external" size={16} />
    </a>
  </article>
) : (
  <article class="linkedin-card linkedin-card--compact">
    <a class="linkedin-card__compact-link" href={href} target="_blank" rel="noreferrer">
      <span class="linkedin-card__compact-label">LinkedIn</span>
      <span class="linkedin-card__compact-number">{number}</span>
      <span class="linkedin-card__compact-action">
        {compactLinkLabel} <Icon name="external" size={16} />
      </span>
    </a>
  </article>
)}
