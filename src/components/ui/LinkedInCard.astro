---
import Icon from './Icon.astro';
import { getLinkedInPostUrl, type LinkedInPost } from '@/data/linkedin-posts';
import { resume } from '@/data/resume';
import { formatDate, getDictionary, type Locale } from '@/i18n/config';
import { withBasePath } from '@/lib/urls';

interface Props {
  post: LinkedInPost;
  locale: Locale;
  index: number;
}

const { post, locale, index } = Astro.props;
const copy = getDictionary(locale).writing;
const number = new Intl.NumberFormat(locale === 'fa' ? 'fa-IR' : 'en', {
  minimumIntegerDigits: 2,
}).format(index + 1);
const excerpt = post.excerpt ?? post.summary;
const topic = post.topic ?? post.category;
const dateValue = post.date ?? post.publishedAt;
const date = dateValue ? formatDate(new Date(`${dateValue}T00:00:00Z`), locale) : undefined;
const directPostUrl = getLinkedInPostUrl(post);
const href = directPostUrl ?? resume.contact.linkedin;
const linkLabel = directPostUrl ? copy.postCta : copy.profileFallback;
const linkAccessibleLabel = post.title ? `${linkLabel}: ${post.title}` : `${linkLabel} ${number}`;
const imageSrc = post.image ? withBasePath(post.image) : undefined;
---

<article class:list={['linkedin-card', imageSrc ? 'linkedin-card--image' : 'linkedin-card--text']}>
  {imageSrc && (
    <div class="linkedin-card__media">
      <img src={imageSrc} alt={post.imageAlt ?? ''} loading="lazy" decoding="async" />
    </div>
  )}
  <div class="linkedin-card__body">
    <header class="linkedin-card__meta">
      <span aria-hidden="true">{number}</span>
      <div>
        {topic && <span>{topic}</span>}
        {date && <time datetime={dateValue}>{date}</time>}
        {!topic && !date && <span>LinkedIn</span>}
      </div>
    </header>
    {post.title && <h3>{post.title}</h3>}
    {excerpt && <p class="linkedin-card__excerpt">{excerpt}</p>}
    <a
      class="text-link"
      href={href}
      target="_blank"
      rel="noreferrer"
      aria-label={linkAccessibleLabel}
    >
      {linkLabel} <Icon name="external" size={16} />
    </a>
  </div>
</article>
